<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ReviewGraph</RootNamespace>
    <AssemblyName>reviewgraph</AssemblyName>
    <!-- Deterministic builds: same input, same binary. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- dotnet tool: dotnet tool install -g reviewgraph -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>reviewgraph</ToolCommandName>
    <PackageId>reviewgraph</PackageId>
    <!-- The release version. CI overrides it from the tag: dotnet pack -p:Version=1.2.3 -->
    <Version>0.1.0</Version>
    <Authors>tommy</Authors>
    <Description>Turns a C# pull request into a storyline graph: changed methods as cards, calls as arrows, entry point to data.</Description>
    <PackageTags>code-review;pull-request;roslyn;graph;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/toch24/review-graph</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/toch24/review-graph</PackageProjectUrl>
  </PropertyGroup>

  <!--
    Normal mode: Roslyn comes from NuGet.
    Offline mode (dotnet build -p:RoslynDir=<sdk>/DotnetTools/dotnet-format): reuse the Roslyn
    assemblies that ship inside the .NET SDK, for machines without nuget.org access.
  -->
  <ItemGroup Condition="'$(RoslynDir)' == ''">
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(RoslynDir)' != ''">
    <Reference Include="$(RoslynDir)/Microsoft.Build.Locator.dll" />
    <Reference Include="$(RoslynDir)/Microsoft.CodeAnalysis.dll" />
    <Reference Include="$(RoslynDir)/Microsoft.CodeAnalysis.CSharp.dll" />
    <Reference Include="$(RoslynDir)/Microsoft.CodeAnalysis.Workspaces.dll" />
    <Reference Include="$(RoslynDir)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll" />
    <Reference Include="$(RoslynDir)/Microsoft.CodeAnalysis.Workspaces.MSBuild.dll" />
    <Reference Include="$(RoslynDir)/Microsoft.CodeAnalysis.Workspaces.MSBuild.BuildHost.dll" />
    <Reference Include="$(RoslynDir)/System.Composition.*.dll" />
    <Reference Include="$(RoslynDir)/Microsoft.Bcl.AsyncInterfaces.dll" />
    <Reference Include="$(RoslynDir)/Humanizer.dll" />
    <Reference Include="$(RoslynDir)/System.IO.Pipelines.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="viewer.html" LogicalName="viewer.html" />
  </ItemGroup>

</Project>
